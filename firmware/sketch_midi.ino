void showBootSplash() {
  // Screen A
  screenA.clearBuffer();
  screenA.drawXBMP(0, 0, 128, 64, epd_bitmap_Bootsplash);
  screenA.sendBuffer();

  // Screen B
  screenB.clearBuffer();
  screenB.drawXBMP(0, 0, 128, 64, epd_bitmap_Bootsplash);
  screenB.sendBuffer();

  delay(1500); // show for 1.5 seconds
}

  // Animation state
  unsigned long lastBlink = 0;
  bool blinkState = true;  // whether the ">" arrow is visible

  unsigned long lastVibrate = 0;
  bool vibrateActive = false;
  int vibrateOffset = 0;




// ============================================================
//  OLED DISPLAYS
// ============================================================

// Active selections
int activePlugin = 0;     // 0=Gojira, 1=Cory, 2=Plini
int currentPreset = -1;   // -1 = none yet selected

// Display names
const char* pluginNames[3] = {
  "GOJIRA",
  "CORY WONG",
  "PLINI"
};

const char* presetNames[3] = {
  "PRESET #1",
  "PRESET #2",
  "PRESET #3"
};


// ============================================================
//  EXPRESSION PEDAL (Wah)
// ============================================================
const int potPin = A0;
int potMin = 0;
int potMax = 234;
const int wahCC = 1;  // CC1 = Wah
int lastCC = -1;


// ============================================================
//  BUTTONS
// ============================================================
// Plugin switching buttons (4, 5, 6)
const int pluginButtons[3] = {4, 5, 6};
int lastPluginState[3] = {HIGH, HIGH, HIGH};
int pluginCC[3] = {20, 21, 22};   // CC20/21/22 for plugin switching

// Preset switching buttons (7, 8, 9)
const int presetButtons[3] = {7, 8, 9};
int lastPresetState[3] = {HIGH, HIGH, HIGH};
int presetPC[3] = {0, 1, 2};      // Preset Program Changes


// ============================================================
//  MIDI HELPERS
// ============================================================
void sendCC(byte cc, byte value) {
  midiEventPacket_t event = {0x0B, 0xB0, cc, value};
  MidiUSB.sendMIDI(event);
}

void sendPC(byte program) {
  midiEventPacket_t event = {0x0C, 0xC0, program, 0};
  MidiUSB.sendMIDI(event);
}


// ============================================================
//  DRAW UI ON SCREENS
// ============================================================
void updateScreens() {

  // ----- LEFT SCREEN (Plugins) -----
  screenB.clearBuffer();
  screenB.setFont(u8g2_font_7x13_tr);
  screenB.drawFrame(0, 0, 128, 64);

  // Icon vibrate offset
  int xOffset = vibrateActive ? vibrateOffset : 0;

  screenB.drawXBMP(108 + xOffset, 0, 20, 20, pluginIcons[activePlugin]);
  screenB.drawStr(5, 13, "PLUGINS:");

  for (int i = 0; i < 3; i++) {
    int y = 28 + i * 14;
    const char* text = pluginNames[i];

    int textWidth = screenB.getStrWidth(text);
    int x = (128 - textWidth) / 2;

    if (i == activePlugin && blinkState) {
      screenB.drawStr(2, y - 2, ">");  // Blinking arrow
    }

    screenB.drawStr(x, y, text);
  }

  screenB.sendBuffer();


  // ----- RIGHT SCREEN (Presets) -----
  screenA.clearBuffer();
  screenA.setFont(u8g2_font_7x13_tr);
  screenA.drawFrame(0, 0, 128, 64);
  screenA.drawXBMP(108 + xOffset, 0, 20, 20, pluginIcons[activePlugin]);

  screenA.drawStr(5, 13, "PRESETS:");

  for (int i = 0; i < 3; i++) {
    int y = 28 + i * 14;
    const char* text = presetNames[i];

    int textWidth = screenA.getStrWidth(text);
    int x = (128 - textWidth) / 2;

    if (i == currentPreset && blinkState) {
      screenA.drawStr(2, y - 2, ">");  // blinking arrow
    }

    screenA.drawStr(x, y, text);
  }

  screenA.sendBuffer();
}



// ============================================================
//  SETUP
// ============================================================
void setup() {
  // Assign correct I2C addresses BEFORE ANY DRAWING
  screenA.setI2CAddress(0x3C * 2); // left screen
  screenB.setI2CAddress(0x3D * 2); // right screen

  screenA.begin();
  screenB.begin();

  showBootSplash(); 


  // Buttons
  for (int i = 0; i < 3; i++) {
    pinMode(pluginButtons[i], INPUT_PULLUP);
    pinMode(presetButtons[i], INPUT_PULLUP);
  }

  updateScreens();  // Draw initial UI
}


// ============================================================
//  MAIN LOOP
// ============================================================
void loop() {
  // ---------------- BLINKING ARROW ----------------
  if (millis() - lastBlink > 350) {
    blinkState = !blinkState;
    lastBlink = millis();
    updateScreens();
  }

  // ---------------- ICON VIBRATION ----------------
  if (vibrateActive && millis() - lastVibrate > 20) {
    vibrateOffset = (vibrateOffset == 1 ? -1 : 1); // jitter
    lastVibrate = millis();
    updateScreens();
  }


  // ---------------- EXPRESSION PEDAL ----------------
  int raw = analogRead(potPin);
  raw = constrain(raw, potMin, potMax);
  int ccValue = map(raw, potMin, potMax, 127, 0);

  if (abs(ccValue - lastCC) > 1) {
    sendCC(wahCC, ccValue);
    lastCC = ccValue;
  }


  // ---------------- PLUGIN SWITCHING BUTTONS (4-6) ----------------
  for (int i = 0; i < 3; i++) {
    int state = digitalRead(pluginButtons[i]);

    if (state == LOW && lastPluginState[i] == HIGH) {
      activePlugin = i;
      sendCC(pluginCC[i], 127);
      updateScreens();
    }

    lastPluginState[i] = state;
  }


  // ---------------- PRESET SWITCHING BUTTONS (7-9) ----------------
  for (int i = 0; i < 3; i++) {
    int state = digitalRead(presetButtons[i]);

    if (state == LOW && lastPresetState[i] == HIGH) {
      sendPC(presetPC[i]);
      currentPreset = i;
      updateScreens();
    }

    lastPresetState[i] = state;
  }

  MidiUSB.flush();
  delay(3);
}
